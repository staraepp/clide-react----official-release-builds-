{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clide",
  "version": "2.1.1",
  "identifier": "com.staraep.clide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "clide",
        "url": "index.html",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "backgroundColor": "#F4F9FD",
        "visible": true
      },
      {
        "label": "hud",
        "url": "hud.html",
        "width": 340,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "../assets/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 190,
          "y": 218
        },
        "applicationFolderPosition": {
          "x": 470,
          "y": 218
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMkU5MUM1NEY2QjhEMjIKUldRaWpXdFB4WkV1c0tHMEFYbzhUOXRLaEFjZEQvWksxczZvU2xQWkFLbmlhV2ZOOWFvbE1vMGUK",
      "endpoints": [
        "https://github.com/staraepp/clide_stt/releases/latest/download/latest.json"
      ]
    }
  }
}
